# Copy to /var/www/linuxpro-website/.env on the VPS (never commit real .env)
# Production VPS — USE_LOCAL_DB_FALLBACK must be false

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
NEXT_PUBLIC_CASHFREE_MODE=production

NEXT_PUBLIC_APP_URL=https://linuxpro.in
NEXTAUTH_URL=https://linuxpro.in
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MONGODB_URI=
MONGODB_DIRECT_URI=
MONGODB_DB_NAME=linuxpro
USE_LOCAL_DB_FALLBACK=false

# HostHeaven VPS API (https://vps.hostheaven.in) — for stock with provider=hostheaven
HOSTHEAVEN_API_BASE_URL=https://vps.hostheaven.in
HOSTHEAVEN_EMAIL=
HOSTHEAVEN_PASSWORD=
HOSTHEAVEN_RESELLER_DOMAIN=vps.hostheaven.in

# OceanLinux reseller API (manage stock with provider=oceanlinux)
OCEANLINUX_API_BASE_URL=https://oceanlinux.com
OCEANLINUX_API_KEY=
OCEANLINUX_API_SECRET=
